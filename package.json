{
  "name": "opencode-billing-widget",
  "version": "0.1.1",
  "description": "Compact OpenCode TUI sidebar widget showing exact dollar spend: current session, today, this week, and this billing month.",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "esbuild src/tui.tsx --jsx=automatic --jsx-import-source=@opentui/solid --format=esm --target=esnext --outfile=dist/tui.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "opencode-plugin",
    "opencode",
    "tui",
    "billing",
    "cost",
    "spend",
    "usage",
    "tokens"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aditya-dhage/opencode-billing-widget.git"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  }
}
